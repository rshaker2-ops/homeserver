<%- include('../partials/header') %>
<header class="page-head">
  <h1>Users</h1>
  <p class="muted">Sign-in is invitation-only: invite someone below, then grant or adjust their services once they appear. Changes apply immediately, even to open sessions.</p>
</header>

<% if (saved) { %><div class="notice">Saved.</div><% } %>
<% if (invited === 'sent') { %><div class="notice">Invitation created and emailed.</div><% } %>
<% if (invited === 'link') { %><div class="notice">Invitation created — email isn't configured, so copy the invite link below and send it to them.</div><% } %>
<% if (invited === 'failed') { %><div class="alert">Invitation created, but the email could not be sent — copy the invite link below and send it yourself.</div><% } %>
<% if (error) { %><div class="alert"><%= error %></div><% } %>

<section class="panel">
  <h2 class="panel-title">Invite someone</h2>
  <p class="muted small">Only invited Google accounts can sign in and create an account. Pick the services they should start with — you can change grants any time after they join.</p>
  <form method="post" action="/admin/invites" class="form-grid">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="field">
      <span>Google account email</span>
      <input name="email" type="email" required maxlength="200" placeholder="family-member@gmail.com">
    </label>
    <fieldset class="grant-set">
      <legend>Start with access to</legend>
      <div class="grant-grid">
        <% for (const s of services) { %>
          <label class="check"><input type="checkbox" name="services" value="<%= s.id %>"> <%= s.name %><%= s.enabled ? '' : ' (disabled)' %></label>
        <% } %>
      </div>
    </fieldset>
    <div class="row-actions">
      <button class="btn btn-primary" type="submit"><%= mailEnabled ? 'Send invitation' : 'Create invitation' %></button>
      <% if (!mailEnabled) { %><span class="muted small">SMTP not configured — you'll get a link to copy.</span><% } %>
    </div>
  </form>
</section>

<% if (invites.length > 0) { %>
  <section class="panel">
    <h2 class="panel-title">Pending invitations</h2>
    <% for (const i of invites) { %>
      <% const preGrants = inviteServices.get(i.id) || new Set(); %>
      <div class="invite-row">
        <div class="invite-info">
          <div class="user-name">
            <%= i.email %>
            <% if (i.expired) { %><span class="chip chip-blocked">expired</span><% } %>
          </div>
          <div class="muted small">
            invited <%= (i.created_at || '').slice(0, 10) %> ·
            <%= i.expired ? 'expired' : 'expires' %> <%= (i.expires_at || '').slice(0, 10) %>
            <% const names = services.filter((s) => preGrants.has(s.id)).map((s) => s.name); %>
            <% if (names.length) { %> · starts with <%= names.join(', ') %><% } %>
          </div>
          <input class="invite-link mono" value="<%= baseUrl %>/invite/<%= i.token %>" readonly data-copy title="Click to copy">
        </div>
        <div class="row-actions">
          <form method="post" action="/admin/invites/<%= i.id %>/resend" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-ghost btn-sm" type="submit"><%= mailEnabled ? 'Resend' : 'New link' %></button>
          </form>
          <form method="post" action="/admin/invites/<%= i.id %>/delete" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-danger btn-sm" type="submit">Revoke</button>
          </form>
        </div>
      </div>
    <% } %>
  </section>
<% } %>

<% if (users.length === 0) { %>
  <div class="empty-state">
    <div class="empty-icon">👋</div>
    <h2>No users yet</h2>
    <p class="muted">Nobody has an account yet. Send an invitation above — people appear here after their first sign-in.</p>
  </div>
<% } %>

<% for (const u of users) { %>
  <% const g = grants.get(u.id) || new Set(); const isSelf = u.id === user.id; %>
  <section class="panel">
    <form method="post" action="/admin/users/<%= u.id %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="user-head">
        <% if (u.picture) { %>
          <img class="avatar avatar-lg" src="<%= u.picture %>" alt="" referrerpolicy="no-referrer">
        <% } else { %>
          <div class="avatar avatar-lg avatar-fallback"><%= (u.name || u.email).slice(0, 1).toUpperCase() %></div>
        <% } %>
        <div class="user-id">
          <div class="user-name">
            <%= u.name || u.email %>
            <% if (isSelf) { %><span class="chip">you</span><% } %>
            <% if (u.is_admin) { %><span class="chip chip-admin">admin</span><% } %>
            <% if (u.is_blocked) { %><span class="chip chip-blocked">blocked</span><% } %>
            <% if (!u.is_admin && !u.is_blocked && g.size === 0) { %><span class="chip chip-pending">pending</span><% } %>
          </div>
          <div class="muted small"><%= u.email %> · first sign-in <%= (u.created_at || '').slice(0, 10) %> · last sign-in <%= (u.last_login_at || '—').slice(0, 16) %></div>
        </div>
      </div>

      <div class="toggle-row">
        <label class="check"><input type="checkbox" name="is_admin" <%= u.is_admin ? 'checked' : '' %> <%= isSelf ? 'disabled' : '' %>> Administrator</label>
        <label class="check"><input type="checkbox" name="is_blocked" <%= u.is_blocked ? 'checked' : '' %> <%= isSelf ? 'disabled' : '' %>> Blocked</label>
      </div>

      <fieldset class="grant-set">
        <legend>Service access<%= u.is_admin ? ' — admins can open every service' : '' %></legend>
        <div class="grant-grid">
          <% for (const s of services) { %>
            <label class="check"><input type="checkbox" name="services" value="<%= s.id %>" <%= g.has(s.id) ? 'checked' : '' %>> <%= s.name %><%= s.enabled ? '' : ' (disabled)' %></label>
          <% } %>
        </div>
      </fieldset>

      <div class="row-actions">
        <button class="btn btn-primary" type="submit">Save</button>
      </div>
    </form>
    <% if (!isSelf) { %>
      <div class="row-actions row-actions-danger">
        <form method="post" action="/admin/users/<%= u.id %>/signout">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-ghost btn-sm" type="submit">Sign out everywhere</button>
        </form>
        <form method="post" action="/admin/users/<%= u.id %>/delete" data-confirm="Remove this user? They can sign in again later but will lose all access grants.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-danger btn-sm" type="submit">Remove</button>
        </form>
      </div>
    <% } %>
  </section>
<% } %>
<%- include('../partials/footer') %>
