# ---- Required -------------------------------------------------------------

# Public URL of the portal (behind Nginx Proxy Manager).
BASE_URL=https://www.lordblight.com

# Google OAuth 2.0 client (Google Cloud Console -> APIs & Services -> Credentials).
# The client's authorized redirect URI must be: $BASE_URL/auth/google/callback
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx

# Long random string used to sign session cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Comma-separated Google account emails that get administrator access.
# Admins manage users/services and can open every service.
ADMIN_EMAILS=you@gmail.com

# ---- Strongly recommended ---------------------------------------------------

# Parent domain for the session cookie. Required for proxy forward-auth so
# im.lordblight.com / nc.lordblight.com / 2fa.lordblight.com can see the
# portal session. Leave unset to scope the cookie to the portal host only.
COOKIE_DOMAIN=lordblight.com

# ---- Invitation emails (optional but recommended) ---------------------------

# Sign-in is invitation-only: you invite each person from Admin -> Users.
# With SMTP configured the portal emails the invitation itself; without it,
# you copy the invite link out of the admin UI and send it yourself.
# Gmail example: host smtp.gmail.com, port 465, user = your Gmail address,
# pass = an App Password (Google Account -> Security -> 2-Step Verification).
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=465
#SMTP_USER=you@gmail.com
#SMTP_PASS=xxxx xxxx xxxx xxxx
# Defaults to SMTP_USER; set to override the From header.
#MAIL_FROM=lordblight.com portal <you@gmail.com>

# How long an invitation stays valid (admins can resend expired ones).
#INVITE_EXPIRY_DAYS=14

# ---- Optional ---------------------------------------------------------------

# Extra allowlists that may sign in WITHOUT an invitation (admins always may).
# Most setups should leave these unset and rely on invitations alone.
#ALLOWED_EMAILS=spouse@gmail.com,kid@gmail.com
#ALLOWED_EMAIL_DOMAINS=

# Shown in the header and page titles.
#PORTAL_NAME=lordblight.com

#PORT=8899
#SESSION_MAX_AGE_DAYS=7
#DATA_DIR=/data
